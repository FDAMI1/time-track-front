{
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "https://time-track-back.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^(?!/api).*$",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}